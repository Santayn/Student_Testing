# Example environment for Docker startup.
# docker-compose.yml is production-safe by default.
# Use start-local.ps1 or docker-compose.local.yml explicitly for local seeded demo data.

POSTGRES_DB=student_test
POSTGRES_USER=student_test
POSTGRES_PASSWORD=

BACKEND_SPRING_PROFILES_ACTIVE=prod
BACKEND_JPA_DDL_AUTO=validate
BACKEND_SQL_INIT_MODE=never
BACKEND_DATA_LOADER_ENABLED=false
APP_PUBLIC_REGISTRATION_ENABLED=false
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
