# Student Testing — canonical environment template.
#
# This is the single environment-variable reference for the whole project.
# Copy it to .env only if you want to configure values manually.
# Keep the real .env small: put there only secrets and values that differ on
# the current machine. Every optional value below already has a project default.

# -----------------------------------------------------------------------------
# Required local secrets
# -----------------------------------------------------------------------------

# PostgreSQL password used by the Docker stack.
POSTGRES_PASSWORD=

# JWT signing secret. Must contain at least 32 characters.
APP_JWT_SECRET=

# -----------------------------------------------------------------------------
# Host-specific local overrides
# -----------------------------------------------------------------------------

# Host port mapped to backend:8080. Vite dev proxy reads the same value.
# BACKEND_PORT=8080

# -----------------------------------------------------------------------------
# PostgreSQL / Docker defaults
# -----------------------------------------------------------------------------

# POSTGRES_DB=student_test
# POSTGRES_USER=student_test

# -----------------------------------------------------------------------------
# Spring / backend runtime defaults
# -----------------------------------------------------------------------------

# SPRING_PROFILES_ACTIVE=local
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# SPRING_JPA_SHOW_SQL=false
# SPRING_SQL_INIT_MODE=always
# SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
# SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=200MB

# APP_DATA_LOADER_ENABLED=true
# APP_PUBLIC_REGISTRATION_ENABLED=false
# APP_CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# Database backup tooling inside the backend container.
# APP_DATABASE_BACKUP_PG_DUMP_PATH=pg_dump
# APP_DATABASE_BACKUP_PSQL_PATH=psql
# APP_DATABASE_BACKUP_SCHEMA=
# APP_DATABASE_BACKUP_INCLUDE_CLEAN=true

# -----------------------------------------------------------------------------
# AI: free-text grading, lecture scans, presentations (see docs/technical/details/ai.md)
# -----------------------------------------------------------------------------

# none (default) | yandex | gigachat | openai (any OpenAI-compatible API, incl. Ollama).
# APP_AI_PROVIDER=none
# APP_AI_API_KEY=
# Yandex Cloud folder id (yandex only).
# APP_AI_FOLDER_ID=
# Empty = provider default. Ollama on the Docker host: http://host.docker.internal:11434/v1
# APP_AI_BASE_URL=
# APP_AI_AUTH_SCHEME=
# APP_AI_TIMEOUT_SECONDS=90
# Tokens per calendar month (input + output), 0 = unlimited.
# APP_AI_MONTHLY_TOKEN_LIMIT=20000000
# APP_AI_MODEL_GRADING=aliceai-llm-flash
# APP_AI_MODEL_LECTURE=aliceai-llm-flash
# APP_AI_MODEL_PRESENTATION=aliceai-llm
# APP_AI_MODEL_IMAGE=aliceai-image-art-3.0
# APP_AI_GRADING_ENABLED=true
# Below this confidence an AI grade goes to the teacher review queue.
# APP_AI_GRADING_REVIEW_THRESHOLD=0.7
# Empty = yandex for the yandex provider, otherwise tesseract (installed in the backend image).
# APP_AI_OCR_PROVIDER=
# APP_AI_IMAGE_GENERATION_ENABLED=true
# APP_AI_IMAGE_SEARCH_ENABLED=true

# -----------------------------------------------------------------------------
# Frontend build/dev defaults
# -----------------------------------------------------------------------------

# VITE_API_BASE_URL=/api/v1
# VITE_API_TIMEOUT_MS=15000
# VITE_SUBMIT_TIMEOUT_MS=180000
# VITE_FILE_TRANSFER_TIMEOUT_MS=0

# APP_PUBLIC_REGISTRATION_ENABLED above is also the single source for the
# frontend registration feature flag. Do not create a second frontend-only flag.

# -----------------------------------------------------------------------------
# Frontend Nginx runtime defaults (Docker frontend only)
# -----------------------------------------------------------------------------

# FRONTEND_PROXY_SEND_TIMEOUT=300s
# FRONTEND_PROXY_READ_TIMEOUT=300s
