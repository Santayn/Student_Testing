# Example environment for Docker startup.
# docker-compose.yml is production-safe by default.
# Use start-local.ps1 or docker-compose.local.yml explicitly for local seeded demo data.

POSTGRES_DB=student_test
POSTGRES_USER=student_test
POSTGRES_PASSWORD=

BACKEND_SPRING_PROFILES_ACTIVE=prod
BACKEND_JPA_DDL_AUTO=validate
BACKEND_SQL_INIT_MODE=never
BACKEND_DATA_LOADER_ENABLED=false
APP_PUBLIC_REGISTRATION_ENABLED=false
APP_JWT_SECRET=
APP_AUTH_LOGIN_MAX_FAILURES=5
APP_AUTH_LOGIN_WINDOW_SECONDS=300
APP_AUTH_LOGIN_BLOCK_SECONDS=60
APP_AUTH_REFRESH_MAX_FAILURES=10
APP_AUTH_REFRESH_WINDOW_SECONDS=300
APP_AUTH_REFRESH_BLOCK_SECONDS=60
APP_AUTH_REFRESH_COOKIE_NAME=student_test_refresh
APP_AUTH_CSRF_COOKIE_NAME=student_test_csrf
# Keep true for HTTPS production. docker-compose.local.yml overrides this to false for local HTTP.
APP_AUTH_REFRESH_COOKIE_SECURE=true
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Lax
APP_CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
