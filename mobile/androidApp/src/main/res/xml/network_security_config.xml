<?xml version="1.0" encoding="utf-8"?>
<!--
  Локальная разработка: бэкенд работает по HTTP (Docker на компьютере разработчика).
  Для production-сервера с HTTPS cleartext стоит отключить.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
