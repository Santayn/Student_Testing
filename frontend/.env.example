# Основная часть REST API
VITE_API_BASE_URL=/api/v1

# Endpoint'ы старого backend, которые находятся непосредственно под /api
VITE_API_ROOT_URL=/api

# Должно совпадать с APP_PUBLIC_REGISTRATION_ENABLED backend
VITE_PUBLIC_REGISTRATION_ENABLED=false

# Таймаут обычных JSON-запросов
VITE_API_TIMEOUT_MS=15000

# Финальный submit теста может ждать синхронную LLM-проверку
VITE_SUBMIT_TIMEOUT_MS=180000

# 0 = не обрывать upload/download по общему Axios timeout
VITE_FILE_TRANSFER_TIMEOUT_MS=0

